<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Panier - ABGYhuDJ</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/webp" href="/Images/logo.webp">
    <link rel="stylesheet" href="/CSS/global.css">

    
</head>

<body>

<%- include('../Partials/header') %>
<%- include('../Partials/logbox') %>
<main class="container my-4">


    <div id="panierVide" class="alert alert-info d-none">
        Votre panier est vide.
    </div>


    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Ville</th>
                    <th>Lieu</th>
                    <th>Places</th>
                    <th>Prix unitaire</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>

            <tbody id="panierBody">

            <% items.forEach(item => { %>
                <tr class="panier-item" data-cart-id="<%= item.id %>">

                    <td class="concert-date"><%= item.date %></td>
                    <td class="concert-ville"><%= item.ville %></td>
                    <td class="concert-lieu"><%= item.lieu %></td>

                    <td>
                        <input type="number"
                            class="form-control qty"
                            min="1"
                            value="<%= item.quantity %>">
                    </td>

                    <td class="price" data-price="<%= item.price %>">
                        <%= item.price %>€
                    </td>

                    <td class="line-total">
                        <%= item.total %>€
                    </td>

                    <td>
                        <button class="btn btn-danger btn-sm remove-item"
                                data-id="<%= item.id %>">
                            Supprimer
                        </button>
                    </td>

                </tr>
            <% }) %>

            </tbody>
        </table>
    </div>


    <div class="d-flex justify-content-end mt-4">
        <div class="card p-3" style="min-width: 250px;">
            <h5 style="color:black">Total</h5>
            <p class="h4 mb-3" id="globalTotal">0€</p>

            <button class="btn secondary-button" id="checkoutButton">
                Valider la commande
            </button>

            <br>

            <a href="/reservation" class="btn secondary-button w-100" id="goToReservation">
                Ajouter des articles
            </a>

            <br>

            <button class="btn secondary-button w-100" id="clearCart">
                Vider le panier
            </button>
        </div>
    </div>


</main>


<div class="modal fade" id="popUpValidationCommande" tabindex="-1" aria-labelledby="paymentModalTitle" aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalTitle">
                    Finaliser la commande
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Fermer">
                </button>
            </div>

            <div class="modal-body">

                <form id="paymentForm">

                    <div class="mb-3">
                        <label for="nom" class="form-label">Nom</label>
                        <input
                            type="text"
                            class="form-control"
                            id="nom"
                            name="nom"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="prenom" class="form-label">Prénom</label>
                        <input
                            type="text"
                            class="form-control"
                            id="prenom"
                            name="prenom"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="cardNumber" class="form-label">
                            Numéro de carte
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="cardNumber"
                            name="cardNumber"
                            placeholder="0000 0000 0000 0000"
                            required>
                    </div>

                    <button
                        class="btn secondary-button w-100"
                        type="submit">

                        Payer

                    </button>

                </form>

            </div>

        </div>
    </div>

</div>

<%- include('../Partials/contact') %>

</body>

<%- include('../Partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/JavaScript/cart.js"></script>
<script src="/JavaScript/authUI.js"></script>

</html>
