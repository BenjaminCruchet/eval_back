<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Panier - ABGYhuDJ</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/webp" href="/Images/logo.webp">
    <link rel="stylesheet" href="/CSS/global.css">

    
</head>

<body>

<%- include('../Partials/header') %>
<%- include('../Partials/logbox') %>
<main class="container my-4">


    <div id="panierVide" class="alert alert-info d-none">
        Votre panier est vide.
    </div>


    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Ville</th>
                    <th>Lieu</th>
                    <th>Places</th>
                    <th>Prix unitaire</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>

            <tbody id="panierBody">

            <% items.forEach(item => { %>
                <tr class="panier-item" data-cart-id="<%= item.id %>">

                    <td class="concert-date"><%= item.date %></td>
                    <td class="concert-ville"><%= item.ville %></td>
                    <td class="concert-lieu"><%= item.lieu %></td>

                    <td>
                        <input type="number"
                            class="form-control qty"
                            min="1"
                            value="<%= item.quantity %>">
                    </td>

                    <td class="price" data-price="<%= item.price %>">
                        <%= item.price %>€
                    </td>

                    <td class="line-total">
                        <%= item.total %>€
                    </td>

                    <td>
                        <button class="btn btn-danger btn-sm remove-item"
                                data-id="<%= item.id %>">
                            Supprimer
                        </button>
                    </td>

                </tr>
            <% }) %>

            </tbody>
        </table>
    </div>


    <div class="d-flex justify-content-end mt-4">
        <div class="card p-3" style="min-width: 250px;">
            <h5>Total</h5>
            <p class="h4 mb-3" id="globalTotal">0€</p>

            <button class="btn secondary-button" id="checkoutBtn">
                Valider la commande
            </button>

            <br>

            <a href="/reservation" class="btn secondary-button w-100" id="goToReservation">
                Ajouter des articles
            </a>

            <br>

            <button class="btn secondary-button w-100" id="clearCart">
                Vider le panier
            </button>
        </div>
    </div>


</main>


<dialog id="checkoutModal" class="p-4">
    <h2>Confirmation</h2>
    <p>Confirmer votre commande ?</p>

    <div class="d-flex gap-2 justify-content-end">
        <button id="cancelCheckout" class="btn btn-secondary">Annuler</button>
        <button id="confirmCheckout" class="btn btn-success">Confirmer</button>
    </div>
</dialog>

<%- include('../Partials/contact') %>

</body>

<%- include('../Partials/footer') %>

<script src="/JavaScript/cart.js"></script>
<script src="/JavaScript/authUI.js"></script>

</html>
