<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Administration - ABGYhuDJ</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">
        
    <link rel="icon" type="image/webp" href="/Images/logo.webp">
    <link rel="stylesheet" href="/CSS/global.css">
</head>

<body>

<%- include('../Partials/header') %>

<main class="container">

        <%- include('../Partials/logbox') %>
    <section class="card shadow-sm mb-5">

        <div class="card-header">
            <h2 class="h5 mb-0">Ajouter un concert</h2>
        </div>

        <div class="card-body">

            <form action="/admin/concerts" method="POST">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label">Ville</label>
                        <input
                            type="text"
                            name="ville"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Lieu</label>
                        <input
                            type="text"
                            name="lieu"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <input
                            type="date"
                            name="date"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Stock</label>
                        <input
                            type="number"
                            name="stock"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Prix (€)</label>
                        <input
                            type="number"
                            name="prix"
                            class="form-control"
                            step="0.01"
                            required>
                    </div>

                </div>

                <div class="mt-4">

                    <button
                        type="submit"
                        class="btn btn-success">

                        Ajouter le concert

                    </button>

                </div>

            </form>

        </div>

    </section>


    <section class="card shadow-sm mb-5">

        <div class="card-header">
            <h2 class="h5 mb-0">Concerts enregistrés</h2>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>ID</th>
                        <th>Ville</th>
                        <th>Lieu</th>
                        <th>Date</th>
                        <th>Stock</th>
                        <th>Prix</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% concerts.forEach(concert => { %>

                    <tr id="row-<%= concert.id %>">
                        
                        <td><%= concert.id %></td>

                        <td> <span class="view ville"><%= concert.ville %></span>
                    <input type= "text" class="edit d-none" id="ville-<%= concert.id %>" value="<%= concert.ville %>"></td>

                                        <td>   <span class="view lieu"><%= concert.lieu %></span>
                    <input type="text" class="edit d-none" id="lieu-<%= concert.id %>" value="<%= concert.lieu %>">
                </td>

                                        <td>
                    <span class="view date"><%= concert.formatedDate %></span>
                    <input type = "date" class="edit d-none" id="date-<%= concert.id %>" value="<%= concert.date.toISOString().split('T')[0] %>"></td>

                                        <td><span class="view stock"><%= concert.stock %></span>
                    <input type ="number" class="edit d-none" id="stock-<%= concert.id %>" value="<%= concert.stock %>">
                </td>

                                        <td> <span class="view prix"><%= concert.prix %> €</span>
                    <input type = "number" step =0.01 class="edit d-none" id="prix-<%= concert.id %>" value="<%= concert.prix %>"></td>

                                        <td>

                    <button class="btn btn-warning btn-sm view edit-btn" data-id="<%= concert.id %>">
                    Modifier
                </button>

                <button class="btn btn-success btn-sm edit d-none save-btn" data-id="<%= concert.id %>">
                    Enregistrer
                </button>

                <button class="btn btn-secondary btn-sm edit d-none cancel-btn" data-id="<%= concert.id %>">
                    Annuler
                </button>

                <button class="btn btn-danger btn-sm view delete-btn" data-id="<%= concert.id %>">
                    Supprimer
                </button>

    

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </section>


    <section class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h2 class="h5 mb-0">
                Commandes
            </h2>

            <a
                href="/admin/orders"
                class="btn btn-primary">

                Voir toutes les commandes

            </a>

        </div>

        <div class="card-body">

            <p class="text-muted mb-0">

                Section prévue mais non développée en back-end à date. Le bouton n'est relié à aucun fonction.

            </p>

        </div>

    </section>

</main>

 <%- include('../Partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/JavaScript/authUI.js"></script>
<script src="/JavaScript/admin.js"></script>
</body>

</html>

