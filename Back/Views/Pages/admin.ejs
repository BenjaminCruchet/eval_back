<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Administration - ABGYhuDJ</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/CSS/global.css">
</head>

<body>

<%- include('../Partials/header') %>

<main class="container">

        <%- include('../Partials/logbox') %>
    <section class="card shadow-sm mb-5">

        <div class="card-header">
            <h2 class="h5 mb-0">Ajouter un concert</h2>
        </div>

        <div class="card-body">

            <form action="/admin/concert" method="POST">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label">Ville</label>
                        <input
                            type="text"
                            name="ville"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Lieu</label>
                        <input
                            type="text"
                            name="lieu"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <input
                            type="date"
                            name="date"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Stock</label>
                        <input
                            type="number"
                            name="stock"
                            class="form-control"
                            required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Prix (€)</label>
                        <input
                            type="number"
                            name="prix"
                            class="form-control"
                            step="0.01"
                            required>
                    </div>

                </div>

                <div class="mt-4">

                    <button
                        type="submit"
                        class="btn btn-success">

                        Ajouter le concert

                    </button>

                </div>

            </form>

        </div>

    </section>


    <section class="card shadow-sm mb-5">

        <div class="card-header">
            <h2 class="h5 mb-0">Concerts enregistrés</h2>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>ID</th>
                        <th>Ville</th>
                        <th>Lieu</th>
                        <th>Date</th>
                        <th>Stock</th>
                        <th>Prix</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% concerts.forEach(concert => { %>

                    <tr>

                        <td><%= concert.id %></td>

                        <td><%= concert.ville %></td>

                        <td><%= concert.lieu %></td>

                        <td><%= concert.date %></td>

                        <td><%= concert.stock %></td>

                        <td><%= concert.prix %> €</td>

                        <td>

                            <a
                                href="/admin/concert/<%= concert.id %>/edit"
                                class="btn btn-warning btn-sm">

                                Modifier

                            </a>

                            <form
                                action="/admin/concert/<%= concert.id %>?_method=DELETE"
                                method="POST"
                                class="d-inline">

                                <button
                                    class="btn btn-danger btn-sm">

                                    Supprimer

                                </button>

                            </form>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </section>


    <section class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h2 class="h5 mb-0">
                Commandes
            </h2>

            <a
                href="/admin/orders"
                class="btn btn-primary">

                Voir toutes les commandes

            </a>

        </div>

        <div class="card-body">

            <p class="text-muted mb-0">

                Cette section permettra de consulter les commandes,
                télécharger les billets, vérifier les paiements
                et suivre les ventes.

            </p>

        </div>

    </section>

</main>

 <%- include('../Partials/footer') %>

<script src="/JavaScript/authUI.js"></script>
</body>

</html>

