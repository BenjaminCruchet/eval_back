<!DOCTYPE html>
<html lang="fr">
    <head> 
        <meta charset="UTF-8">
        <title> ABGYhuDJ tournée </title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel = "stylesheet" href="/CSS/global.css">
        <link rel = "stylesheet" href="/CSS/reservation.css">
        <meta name = "description" content = "Prenez vos places pour un show d'une heure et demi en compagnie du célèbre ABGYhuDJ">
        <meta name ="keywords" content = "ABGYhuDJ, youtube, concert, tournée, places, reservation">
        <meta name="viewport" content="width=device-width, initial-scale =1.0">
        <link rel="icon" type="image/webp" href="/Images/logo.webp">
    </head>

    <body>

         <%- include('../Partials/header') %>

        <main>

            <%- include('../Partials/logbox') %>
            
            <div id = "searchContainer">
                <form id ="searchForm"> 
                    <input type="search" id="searchBarre" placeholder="ABGYhuDJ en concert dans ta ville ?">
                    <button type="button" id="loupe"> 
                        <svg role="graphics-symbol" aria-label="Magnifying glass" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="black">
                            <title> Magnifying glass </title>
                            <path id ="logoLoupe" d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/>
                        </svg>
                    </button>
                </form>  
                <div id="suggestionContainer" role="listbox" aria-label="Suggestions de recherche"></div>
            </div>

            <div class = "scrolleur">
                <div class ="centreur" > 
                    <table id="concerts">
                        <thead>
                            <tr> 
                                <th scope = "col" >
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                        <path d="M291.5-411.5Q280-423 280-440t11.5-28.5Q303-480 320-480t28.5 11.5Q360-457 360-440t-11.5 28.5Q337-400 320-400t-28.5-11.5Zm160 0Q440-423 440-440t11.5-28.5Q463-480 480-480t28.5 11.5Q520-457 520-440t-11.5 28.5Q497-400 480-400t-28.5-11.5Zm160 0Q600-423 600-440t11.5-28.5Q623-480 640-480t28.5 11.5Q680-457 680-440t-11.5 28.5Q657-400 640-400t-28.5-11.5ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z"/>
                                    </svg> 
                                    <span> Date </span> 
                                </th>
                                <th scope = "col" >
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                        <path d="M120-120v-560h240v-80l120-120 120 120v240h240v400H120Zm80-80h80v-80h-80v80Zm0-160h80v-80h-80v80Zm0-160h80v-80h-80v80Zm240 320h80v-80h-80v80Zm0-160h80v-80h-80v80Zm0-160h80v-80h-80v80Zm0-160h80v-80h-80v80Zm240 480h80v-80h-80v80Zm0-160h80v-80h-80v80Z"/>
                                    </svg>
                                    <span> Ville </span> 
                                </th>
                                <th scope = "col" > 
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                        <path d="M536.5-503.5Q560-527 560-560t-23.5-56.5Q513-640 480-640t-56.5 23.5Q400-593 400-560t23.5 56.5Q447-480 480-480t56.5-23.5ZM480-186q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Zm0-480Z"/>
                                    </svg>
                                    <span> Lieu </span> 
                                </th>
                                <th scope = "col" >
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                        <path d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm0-160q17 0 28.5-11.5T520-480q0-17-11.5-28.5T480-520q-17 0-28.5 11.5T440-480q0 17 11.5 28.5T480-440Zm0-160q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm320 440H160q-33 0-56.5-23.5T80-240v-160q33 0 56.5-23.5T160-480q0-33-23.5-56.5T80-560v-160q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v160q-33 0-56.5 23.5T800-480q0 33 23.5 56.5T880-400v160q0 33-23.5 56.5T800-160Zm0-80v-102q-37-22-58.5-58.5T720-480q0-43 21.5-79.5T800-618v-102H160v102q37 22 58.5 58.5T240-480q0 43-21.5 79.5T160-342v102h640ZM480-480Z"/>
                                    </svg>
                                    <span> Places </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% concerts.forEach(concert => { %>
                                <tr class="ligne">
                                    <td class="date">
                                        <%= concert.formatedDate %>
                                    </td>

                                    <td class="ville">
                                        <%= concert.ville %>
                                    </td>

                                    <td class="lieu">
                                        <%= concert.lieu %>
                                    </td>

                                    <td>
                                        <button type="button" class="primary-button openModal" data-concert-id = "<%= concert.id %>" data-price = "<%= concert.places.prix %>" > 
                                            Réserver
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
                <%- include('../Partials/contact') %>

            <dialog class="popUp" id="popUpReservation" aria-labelledby="popUpReservationAccessTitle" aria-describedby="popUpReservationAccessDescription">
                    <h2 class="visually-hidden" id="popUpReservationAccessTitle"> Formulaire de réservation </h2>
                    <p class= "visually-hidden" id="popUpReservationAccessDescription"> Formulaire de réservation pour le concert de ABGYhuDJ le <span class="modalDate"></span> à <span class="modalVille"></span>, salle <span class="modalLieu"></span> à 20h
                    </p>
                <button type="button" class="closeModal" id="closepopUpReservation">X</button>
                <div class="conteneur" id="modalTitleConteneur">
                    <h2 id="modalTitle"> Concert de ABGYhuDJ </h2>
                </div>
                <div class="conteneur" id="modalCoreMessage">
                    <div class = conteneur >
                        <span class="modalCoreText"> Le : </span> 
                        <span class="textInsert modalDate"> </span> 
                    </div>
                    <div class = "conteneur" >
                        <span class="modalCoreText"> à : </span> 
                        <span class="textInsert modalVille"></span> 
                    </div>
                    <div class = "conteneur" >
                        <span class="modalCoreText"> lieu : </span> 
                        <span class="textInsert modalLieu"></span>
                    </div>
                    <div class = "conteneur" >
                        <span> horaire : </span>
                        <span class="textInsert" id="modalHeure"> 20h</span>
                    </div>
                </div>
                <div class="alert" id="alertDoublon"> 
                    <svg class = "warningIcon" aria-label="Warning icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" >
                        <title> Warning icon </title>
                        <path d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm330.5-51.5Q520-263 520-280t-11.5-28.5Q497-320 480-320t-28.5 11.5Q440-297 440-280t11.5 28.5Q463-240 480-240t28.5-11.5ZM440-360h80v-200h-80v200Zm40-100Z"/>
                    </svg>
                    <span id="warning">Il y a d'autres dates dans cette ville. Vérifiez bien la date avant de valider</span>
                    <svg class = "warningIcon" aria-label="Warning icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" >
                        <title> Warning icon </title>
                        <path d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm330.5-51.5Q520-263 520-280t-11.5-28.5Q497-320 480-320t-28.5 11.5Q440-297 440-280t11.5 28.5Q463-240 480-240t28.5-11.5ZM440-360h80v-200h-80v200Zm40-100Z"/>
                    </svg>
                </div>
                <form id="formPopUpReservation">
                    <fieldset> 
                        <legend class="legend"> Tarifs : </legend>
                            <p> Tarif unique :
                                <span id= "PU"> 35 </span> <span> € </span>
                            </p> 
                           <label for="nbPlace"> Nombre de places : </label>  
                                <span>
                                    <select id="nbPlace">
                                        <option value="1"> 1 </option>
                                        <option value="2"> 2 </option>
                                        <option value="3"> 3 </option>
                                        <option value="4"> 4 </option>
                                        <option value="5"> 5 </option>
                                        <option value="6"> 6 </option>
                                        <option value="7"> 7 </option>
                                        <option value="8"> 8 </option>
                                        <option value="9"> 9 </option>
                                        <option value="10"> 10 </option>
                                    </select>    
                                </span>              
                        <p> Total : 
                            <span class = textInsert id="total"></span> 
                        </p>
                        <button type="submit" class="secondary-button" id="reservation"> Ajouter au panier </button>
                        <a href="/cart"> Voir le panier </a> 
                    </fieldset>
                </form>
            </dialog>

            <dialog class="popUp" id="popUpCommande" aria-labelledby="popUpCommandeTitle">
                <h2 class="visually-hidden" id="popUpCommandeTitle"> Confirmation de commande </h2>
                <button type="button" class="closeModal"> X </button>
                <p class="popUpText"> L'ajout de 
                    <span id="nbPlacesPopUp"></span>
                    <span> place(s) pour le concert du </span>
                    <span id="datePopUp"></span>
                    <span> à </span>
                    <span id="villePopUp"></span>
                    <span> : 20h, a bien été effectué. </span>
                </p>
                
                <div class="buttonContainer">     
                    <a href="/cart"> Voir le panier </a> 
                </div>    
                
            </dialog>

            <dialog class="popUp" id="popUpConfirmation" aria-labelledby="popUpConfirmationTitle"> 
                <h2 class="visually-hidden" id="popUpConfirmationTitle"> Commande validée </h2>
                <button type="button" class="closeModal"> X </button>
                <p class="popUpText"> Votre réservation a bien été prise en compte ! </p>
                <p class="popUpText"> Vos places en format numérique vous ont été envoyées à l'adresse mail suivante : </p> 
                <p class="popUpText" id="Usermail"></p>
                <p class="popUpText"> Amusez vous bien ! </p>
                <button type="button" class="secondary-button" id="confirmationOK"> OK </button>
            </dialog>

            <dialog class="popUp" id="popUpError" aria-labelledby="popUpErrorTitle">
                <h2 class="visually-hidden" id="popUpErrorTitle"> Recherche erronée </h2>
                <button type="submit" class="closeModal"> X </button>
                <p> Nous n'avons malheureusement trouvé aucun évènement qui corresponde à votre recherche :
                    <span id="infoCherchee"></span>
                </p>
                <p> N'hésitez pas à cliquer sur les suggestions qui apparaissent lorsque vous saississez une date, une ville ou un lieu dans le champ de recherche.</p>
            </dialog>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/JavaScript/reservation.js"></script>
        <script src="/JavaScript/authUI.js"></script>
        
        <%- include('../Partials/footer') %>
        
    </body>
</html>